NODE_ENV=production
# On Hostinger Node.js hosting, use the port assigned by the Node.js app panel.
# Do not force 5000 if Hostinger provides/injects a different PORT.
PORT=
API_VERSION=v1

# Public URLs
BASE_URL=https://api.buizz.com
BACKEND_URL=https://api.buizz.com
FRONTEND_URL=https://www.buizz.com
ADMIN_FRONTEND_URL=https://admin.buizz.com
CORS_ORIGINS=https://www.buizz.com,https://buizz.com,https://admin.buizz.com

# Live MySQL database
MYSQL_HOST=<rds-endpoint>
MYSQL_PORT=3306
MYSQL_DATABASE=buizz
MYSQL_USER=buizz_app
MYSQL_PASSWORD=<load-from-ssm-parameter-store>
MYSQL_CONNECTION_LIMIT=10

# Auth
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-production-secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
ADMIN_REGISTRATION_SECRET=replace-with-a-long-random-admin-registration-secret
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_API_VERSION=v25.0
# Set the Facebook values above in Hostinger's Node.js environment variables,
# then restart the API application. Do not put FACEBOOK_APP_SECRET in the client.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# BullMQ uses private Amazon ElastiCache for Valkey in production.
QUEUE_PROVIDER=bullmq
DISABLE_REDIS=false
REDIS_DISABLED=false
REDIS_HOST=<elasticache-primary-endpoint>
REDIS_PORT=6379
REDIS_PASSWORD=<load-from-ssm-parameter-store>
REDIS_TLS=true
REDIS_TLS_REJECT_UNAUTHORIZED=true
BULLMQ_PREFIX=buizz
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=5000
QUEUE_COMPLETED_RETENTION_SECONDS=86400
QUEUE_FAILED_RETENTION_SECONDS=1209600
WORKER_HEALTH_PORT=9090

# Temporary production media provider while AWS CloudFront is pending.
# The API and worker fail startup when required credentials are invalid.
MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_REQUIRED=true
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
MAX_UPLOAD_BYTES=5242880

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Payments
PHONEPE_ENV=PRODUCTION
PHONEPE_CLIENT_VERSION=1
PHONEPE_CLIENT_ID=<load-from-ssm-parameter-store>
PHONEPE_CLIENT_SECRET=
PHONEPE_MERCHANT_ID=<load-from-ssm-parameter-store>
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
PHONEPE_API_URL=
PHONEPE_CHECKOUT_URL=
PHONEPE_IDENTITY_URL=
PHONEPE_CALLBACK_USERNAME=
PHONEPE_CALLBACK_PASSWORD=
PHONEPE_REDIRECT_URL=https://www.buizz.com/payment/callback
PHONEPE_CALLBACK_URL=https://api.buizz.com/api/v1/payments/phonepe/callback

# WhatsApp / Meta / Interakt
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
INTERAKT_API_URL=
INTERAKT_API_KEY=
INTERAKT_PHONE_NUMBER_ID=
WHATSAPP_PUBLIC_BASE_URL=https://api.buizz.com

# Business rules
PLATFORM_FEE_PERCENT=10
SETTLEMENT_HOLD_DAYS=7
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# The legacy MySQL notification queue is retired in AWS production.
# Start the dedicated process with: npm run start:worker
