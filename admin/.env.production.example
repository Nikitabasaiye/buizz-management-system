NODE_ENV=production
ADMIN_PORT=5001
API_VERSION=v1

# Public URLs
FRONTEND_URL=https://www.buizz.com
ADMIN_FRONTEND_URL=https://admin.buizz.com
BACKEND_URL=https://api.buizz.com
CORS_ORIGINS=https://admin.buizz.com,https://www.buizz.com,https://buizz.com

# Live MySQL database
MYSQL_HOST=<rds-endpoint>
MYSQL_PORT=3306
MYSQL_DATABASE=buizz
MYSQL_USER=buizz_app
MYSQL_PASSWORD=<load-from-ssm-parameter-store>
MYSQL_CONNECTION_LIMIT=10

# Auth
JWT_SECRET=replace-with-the-same-production-jwt-secret-used-by-server-if-sharing-tokens
JWT_REFRESH_SECRET=replace-with-the-same-production-refresh-secret-used-by-server-if-sharing-tokens
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
ADMIN_REGISTRATION_SECRET=replace-with-a-long-random-admin-registration-secret

# Redis is optional in the current app.
DISABLE_REDIS=true
REDIS_DISABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Payments / WhatsApp
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_API_URL=
PHONEPE_CHECKOUT_URL=
PHONEPE_IDENTITY_URL=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_WHATSAPP_API_URL=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
INTERAKT_API_URL=
INTERAKT_API_KEY=
INTERAKT_PHONE_NUMBER_ID=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
