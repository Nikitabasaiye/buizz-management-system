#!/bin/bash
set -euo pipefail

for attempt in 1 2 3 4 5; do
  if dnf install -y docker git jq curl; then
    break
  fi
  if [ "${attempt}" -eq 5 ]; then
    echo "Package installation failed after five attempts" >&2
    exit 1
  fi
  sleep $((attempt * 15))
done

systemctl enable --now docker
usermod -aG docker ec2-user

# Amazon Linux does not consistently ship the Docker Compose v2 plugin.
# Install a pinned release so CI deployments do not depend on package drift.
compose_version="v2.40.3"
mkdir -p /usr/local/lib/docker/cli-plugins
curl --fail --location --retry 3 \
  "https://github.com/docker/compose/releases/download/$${compose_version}/docker-compose-linux-x86_64" \
  --output /usr/local/lib/docker/cli-plugins/docker-compose
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

mkdir -p /opt/buizz
if [ ! -d /opt/buizz/repository/.git ]; then
  git clone "${repository_clone_url}" /opt/buizz/repository
fi
chown -R ec2-user:ec2-user /opt/buizz

mkdir -p /opt/buizz/repository/docker/production/env
mkdir -p /opt/buizz/repository/docker/production/certbot/www
mkdir -p /opt/buizz/repository/docker/production/certbot/conf
