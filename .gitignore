**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*-plan.txt
**/terraform.tfvars
**/.terraform.lock.hcl.backup
crash.log

# Deployment runtime files and certificates
docker/production/env/
docker/production/certbot/
deployments/
