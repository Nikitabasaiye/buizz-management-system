aws_region                = "ap-south-1"
environment               = "production"
github_repository         = "devopsbuizz/buizz-management-system"
repository_clone_url      = "https://github.com/devopsbuizz/buizz-management-system.git"
instance_type             = "t3.micro"
db_instance_class         = "db.t4g.micro"
cache_node_type           = "cache.t4g.micro"
alert_email               = "contact@buizz.com"
protect_data_from_destroy = true
enable_cloudfront         = false # Change only after AWS account verification.
