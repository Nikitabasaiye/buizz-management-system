NODE_ENV=production
# On Hostinger Node.js hosting, use the port assigned by the Node.js app panel.
# Do not force 5000 if Hostinger provides/injects a different PORT.
PORT=
API_VERSION=v1

# Public URLs
BASE_URL=https://api.buizz.com
BACKEND_URL=https://api.buizz.com
FRONTEND_URL=https://www.buizz.com
ADMIN_FRONTEND_URL=https://admin.buizz.com
CORS_ORIGINS=https://www.buizz.com,https://buizz.com,https://admin.buizz.com

# Live MySQL database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=u943298757_buizz
MYSQL_USER=u943298757_buizz
MYSQL_PASSWORD="Buizz2026Mgmt@99"
MYSQL_CONNECTION_LIMIT=10

# Auth
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-production-secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
ADMIN_REGISTRATION_SECRET=replace-with-a-long-random-admin-registration-secret
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_API_VERSION=v25.0
# Set the Facebook values above in Hostinger's Node.js environment variables,
# then restart the API application. Do not put FACEBOOK_APP_SECRET in the client.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Redis is optional in the current app.
DISABLE_REDIS=true
REDIS_DISABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Uploads: Configure Cloudinary for cloud storage
# Leave blank to use local storage (not recommended for production)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Payments
PHONEPE_ENV=PRODUCTION
PHONEPE_CLIENT_VERSION=1
PHONEPE_CLIENT_ID=SU2606091502318960141617
PHONEPE_CLIENT_SECRET=
PHONEPE_MERCHANT_ID=M22V5Y6OTVZY0
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
PHONEPE_API_URL=
PHONEPE_CHECKOUT_URL=
PHONEPE_IDENTITY_URL=
PHONEPE_CALLBACK_USERNAME=
PHONEPE_CALLBACK_PASSWORD=
PHONEPE_REDIRECT_URL=https://www.buizz.com/payment/callback
PHONEPE_CALLBACK_URL=https://api.buizz.com/api/v1/payments/phonepe/callback

# WhatsApp / Meta / Interakt
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
INTERAKT_API_URL=
INTERAKT_API_KEY=
INTERAKT_PHONE_NUMBER_ID=
WHATSAPP_PUBLIC_BASE_URL=https://api.buizz.com

# Business rules
PLATFORM_FEE_PERCENT=10
SETTLEMENT_HOLD_DAYS=7
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Hostinger cron processes this many MySQL notification jobs per invocation.
NOTIFICATION_CRON_BATCH_SIZE=50
